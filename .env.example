# Environment variables FractalSwarm reads. This file only documents them.
# Real values live outside the repo in ~/.fractalswarm/.env, shared by every worktree.
# A local .env (gitignored) overrides it, and real environment variables override both.

# Meta Model API key (dev.meta.ai -> API keys). Keys start with LLM_.
MODEL_API_KEY=
# Hugging Face read token, for the gated meta-llama/Llama-Prompt-Guard-2-22M model.
HF_TOKEN=
# Hard cap on total Meta Model API spend across all runs, in USD.
FRACTALSWARM_PROJECT_CAP_USD=150
