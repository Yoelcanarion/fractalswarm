{
  "id": "s4-lens",
  "title": "The Muse lens: any call, with the sentence behind it",
  "stage": "run",
  "duration_ms": 18000,
  "calls": {
    "spark": { "model": "spark", "purpose": "work", "actor": "o3.1.a1", "nth": 1 },
    "wonder": { "model": "wonder", "role": "root_planner" }
  },
  "steps": [
    { "do": "speed", "x": 15 },
    { "do": "play" },
    { "do": "wait", "until": "call-end:spark", "timeout_ms": 8000 },
    { "do": "pause" },
    { "do": "lens", "open": "wonder" },
    { "do": "highlight", "target": { "region": "lens" }, "ms": 1400 },
    { "do": "wait", "ms": 2800 },
    { "do": "lens", "open": "spark" },
    { "do": "highlight", "target": { "actor": "o3.1.a1" }, "ms": 1700 },
    { "do": "wait", "ms": 1800 },
    { "do": "camera", "fit": { "region": "lens-call" }, "pad": 0.03, "ms": 1000 },
    { "do": "wait", "ms": 1100 },
    { "do": "highlight", "target": { "region": "lens-sentence" }, "ms": 4850 },
    { "do": "wait", "ms": 4850 },
    { "do": "camera", "home": true, "ms": 700 },
    { "do": "lens", "close": true },
    { "do": "highlight", "target": { "region": "meter" }, "ms": 3350 },
    { "do": "wait", "ms": 3350 }
  ]
}
