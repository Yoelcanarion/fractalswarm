    },
    {
      "label": "Preserved work (%)",
      "metric": "preserved_pct",
      "note": "calls in flight at a crash that were used"
    },
    {
      "label": "Duplicated spend ($)",
      "metric": "dup_usd",
      "note": "work paid twice, by every cause"
    }
  ],
